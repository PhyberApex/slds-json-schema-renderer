{
  "name": "slds-json-schema-renderer",
  "type": "module",
  "version": "1.5.75",
  "description": "A CLI tool to generate documentation from JSON schema files",
  "author": "PhyberApex",
  "license": "MIT",
  "repository": {
    "url": "git+https://github.com/PhyberApex/slds-json-schema-renderer.git"
  },
  "keywords": [
    "json-schema",
    "documentation",
    "cli",
    "static-site-generator",
    "vue",
    "slds"
  ],
  "main": "lib/index.js",
  "bin": {
    "slds-json-schema-renderer": "bin/cli.js"
  },
  "files": [
    "LICENSE",
    "README.md",
    "bin/",
    "lib/"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "node ./bin/cli.js",
    "clean": "rimraf lib",
    "build:cli": "babel src --out-dir lib --copy-files --ignore 'src/frontend/**' --config-file ./babel.config.json",
    "dev": "npm run mock-data && vite",
    "mock-data": "node prepareMockData.js",
    "build:frontend": "vite build",
    "build": "npm run clean && npm run build:cli && npm run build:frontend",
    "prepublishOnly": "npm run build",
    "pages": "npm run build && npm run start -- generate -i ./test/ -o docs",
    "lint": "eslint",
    "lint:fix": "eslint --fix",
    "test": "vitest run --project unit --project frontend",
    "test:smoke": "vitest run --project smoke",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "prepare": "husky"
  },
  "dependencies": {
    "@apidevtools/json-schema-ref-parser": "16.0.5",
    "@salesforce-ux/design-system": "2.264.2",
    "ajv": "8.20.0",
    "ajv-draft-04": "1.0.0",
    "chalk": "6.0.1",
    "commander": "15.0.0",
    "fs-extra": "11.4.1",
    "glob": "13.0.6",
    "motion-v": "2.8.0"
  },
  "devDependencies": {
    "@antfu/eslint-config": "9.5.1",
    "@babel/cli": "8.0.6",
    "@babel/core": "8.0.7",
    "@babel/preset-env": "8.0.7",
    "@vitejs/plugin-vue": "6.0.10",
    "@vitest/coverage-v8": "5.0.5",
    "@vue/test-utils": "2.5.1",
    "esbuild": "0.28.2",
    "eslint": "10.13.0",
    "husky": "9.1.7",
    "jsdom": "30.1.3",
    "lint-staged": "17.6.0",
    "rimraf": "6.1.3",
    "vite": "8.3.4",
    "vite-plugin-vue-devtools": "8.2.1",
    "vitest": "5.0.5",
    "vue": "3.5.44"
  },
  "lint-staged": {
    "*.{js,vue,yml}": [
      "eslint --fix"
    ],
    "*.{js,vue}": [
      "vitest related --run"
    ]
  }
}
