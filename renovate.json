{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    "security:minimumReleaseAgeNpm"
  ],
  "packageRules": [
    {
      "description": "Minor and patch updates merge themselves once the required checks pass",
      "matchUpdateTypes": ["minor", "patch"],
      "automerge": true
    }
  ]
}
